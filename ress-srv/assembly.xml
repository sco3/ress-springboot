<?xml version="1.0"?>
<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2 http://maven.apache.org/xsd/assembly-1.1.2.xsd">
  <id>r${buildNumber}</id>
  <baseDirectory>${project.artifactId}</baseDirectory>
  <formats>
    <format>dir</format>
  </formats>
  <fileSets>
    <fileSet>
      <directory>${basedir}/src/main/assembly</directory>
      <outputDirectory>/</outputDirectory>
      <includes>
        <include>**/*.sh</include>
      </includes>
      <lineEnding>unix</lineEnding>
      <fileMode>744</fileMode>
    </fileSet>
    <fileSet>
      <directory>${basedir}/src/main/assembly</directory>
      <outputDirectory>/</outputDirectory>
      <includes>
        <include>**/*.template</include>
        <include>**/*.dev</include>
        <include>**/*.xml</include>
        <include>**/*.properties</include>
        <include>**/passwd</include>
      </includes>
      <lineEnding>unix</lineEnding>
      <fileMode>644</fileMode>
    </fileSet>
  </fileSets>
  <dependencySets>
    <dependencySet>
      <excludes>
        <exclude>com.tnf.postinstall:postinstall-util</exclude>
        <exclude>log4j:*</exclude>
        <exclude>org.slf4j:slf4j-log4j12</exclude>
      </excludes>
      <outputDirectory>lib</outputDirectory>
      <fileMode>644</fileMode>
    </dependencySet>
    <dependencySet>
      <includes>
        <include>com.tnf.postinstall:postinstall-util</include>
      </includes>
      <outputDirectory>lib</outputDirectory>
      <outputFileNameMapping>postinstall-util.jar</outputFileNameMapping>
      <fileMode>644</fileMode>
    </dependencySet>
  </dependencySets>
</assembly>
