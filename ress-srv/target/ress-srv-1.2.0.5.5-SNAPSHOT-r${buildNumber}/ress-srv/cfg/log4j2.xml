<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="warn" monitorinterval="300">
  <Appenders>
    <RollingFile name="all" fileName="log/all.log" filePattern="log/all.log.%i" ignoreExceptions="false">
      <PatternLayout>
        <Pattern>%d{yyyy.MM.dd-HH:mm:ss.SSS}  [%-5level] %t [%c{1} %C{1}.%M{1}]: %msg%n</Pattern>
      </PatternLayout>
      <Policies>
        <SizeBasedTriggeringPolicy size="50MB"/>
      </Policies>
      <DefaultRolloverStrategy max="20"/>
    </RollingFile>
    <RollingFile name="main" fileName="log/main.log" filePattern="log/main.log.%i" ignoreExceptions="false">
      <PatternLayout>
        <Pattern>%d{yyyy.MM.dd-HH:mm:ss.SSS}  [%-5level] %t [%c{1} %C{1}.%M{1}]: %msg%n</Pattern>
      </PatternLayout>
      <Policies>
        <SizeBasedTriggeringPolicy size="50MB"/>
      </Policies>
      <DefaultRolloverStrategy max="20"/>
    </RollingFile>
    <RollingFile name="audit" fileName="log/audit.log" filePattern="log/audit.log.%i" ignoreExceptions="false">
      <PatternLayout>
        <Pattern>%msg%n</Pattern>
      </PatternLayout>
      <Policies>
        <SizeBasedTriggeringPolicy size="50MB"/>
      </Policies>
      <DefaultRolloverStrategy max="20"/>
    </RollingFile>
    <RollingFile name="constat" fileName="log/constant.log" filePattern="log/constat.log.%i" ignoreExceptions="false">
      <PatternLayout>
        <Pattern>%msg%n</Pattern>
      </PatternLayout>
      <Policies>
        <SizeBasedTriggeringPolicy size="50MB"/>
      </Policies>
      <DefaultRolloverStrategy max="20"/>
    </RollingFile>
  </Appenders>
  <Loggers>
    <Logger name="com.tnf" level="info">
      <AppenderRef ref="main"/>
    </Logger>
    <Logger name="constat" level="info">
      <AppenderRef ref="constat"/>
    </Logger>
    <Logger name="audit" level="info">
      <AppenderRef ref="audit"/>
    </Logger>
    <Root level="info">
      <AppenderRef ref="all"/>
    </Root>
  </Loggers>
</Configuration>
